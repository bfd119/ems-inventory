# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
# .env は .gitignore に登録済みなのでコミットされません。

# Supabase プロジェクト URL
SUPABASE_URL=https://aacntdoacjjssspoctul.supabase.co

# Supabase シークレットキー（sb_secret_... ）
# Supabase ダッシュボード > Settings > API Keys > Publishable and secret API keys で発行
# ※ 旧 service_role キーは 2026年末で廃止されるため使用しないこと
SUPABASE_SECRET_KEY=

# リマインドメール送信用（GitHub Actions では Secrets に登録する）
# Gmail のアプリパスワード（16桁）。2段階認証を有効にしてから発行する
SMTP_USER=
SMTP_PASS=
